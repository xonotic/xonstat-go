    "paths": {
        "/game/{id}": {
            "get": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Game information",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "game_id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.gameInfoJSONResponse"
                        }
                    }
                }
            }
        },
        "/game/{id}/weapons": {
            "get": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Weapon information for a given game formatted for Chart.js",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "game_id",
                        "name": "id",
                        "in": "path"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.gameWeaponInfoJSONResponse"
