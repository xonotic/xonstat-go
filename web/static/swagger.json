                    }
                }
            }
        },
        "/games": {
            "get": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Games played by various filter criteria",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "server_id filter",
                        "name": "server_id",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "map_id filter",
                        "name": "map_id",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "player_id filter",
                        "name": "player_id",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "game_type_cd filter",
                        "name": "game_type_cd",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "game_id range lower bound",
                        "name": "start_game_id",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "game_id range upper bound",
                        "name": "end_game_id",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/handlers.recentGamesJSONResponse"
                            }
                        }
                    }
                }
            }
        },
